# =============================================
# SMK Ghama Caraka — Backend Environment Config
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke repository!
# =============================================

# App
APP_PORT=3000
APP_ENV=development

# Database (PostgreSQL via Docker)
USE_EXTERNAL_POSTGRES=true
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
POSTGRES_USER=absensi_user
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
POSTGRES_DB=absensi_db
POSTGRES_PORT=5432

# CORS — daftarkan semua origin frontend yang diizinkan (pisah dengan koma)
# Development: http://localhost:5173
# Production: https://domain-sekolah.sch.id
CORS_ORIGIN=http://localhost:5173

# JWT — WAJIB diganti dengan string acak minimal 32 karakter di production
# Generate: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER

# Password default siswa baru (bisa diubah oleh siswa setelah login pertama)
STUDENT_DEFAULT_PASSWORD=GANTI_DENGAN_PASSWORD_DEFAULT
